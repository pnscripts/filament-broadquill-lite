{
    "name": "pnscripts/filament-broadquill-lite",
    "description": "Broadquill Lite: bulk edit for Filament tables. Select records, tick the fields to change, apply once, with per-record policy checks and a clear summary.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "filament",
        "filamentphp",
        "filament-plugin",
        "bulk edit",
        "bulk update",
        "mass update",
        "bulk action",
        "tables"
    ],
    "homepage": "https://pnscripts.com/marketplace/filament-broadquill",
    "authors": [
        {
            "name": "PN Scripts",
            "email": "office@pnscripts.com",
            "homepage": "https://pnscripts.com"
        }
    ],
    "support": {
        "email": "office@pnscripts.com",
        "issues": "https://github.com/pnscripts/filament-broadquill-lite/issues",
        "source": "https://github.com/pnscripts/filament-broadquill-lite",
        "docs": "https://github.com/pnscripts/filament-broadquill-lite#readme"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^4.0|^5.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "PNScripts\\BroadquillLite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PNScripts\\BroadquillLite\\Tests\\": "tests/"
        },
        "files": [
            "tests/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "PNScripts\\BroadquillLite\\BroadquillLiteServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
